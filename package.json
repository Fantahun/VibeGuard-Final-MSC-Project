{
  "name": "vibeguard",
  "version": "1.0.0",
  "description": "VibeGuard: Security-Integrated Development Framework prototype for Node.js microservices",
  "main": "src/cli/cli.js",
  "bin": {
    "vibeguard": "./src/cli/cli.js"
  },
  "scripts": {
    "start": "node src/cli/cli.js",
    "cli": "node src/cli/cli.js",
    "experiment": "node src/experiment/runner.js",
    "test": "jest --coverage",
    "lint": "eslint src --ext .js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js"]
  },
  "dependencies": {
    "openai": "^4.47.0",
    "@anthropic-ai/sdk": "^0.24.0",
    "commander": "^12.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "dotenv": "^16.4.5",
    "eslint-plugin-security": "^3.0.1",
    "eslint": "^9.0.0",
    "axios": "^1.7.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "license": "MIT"
}
