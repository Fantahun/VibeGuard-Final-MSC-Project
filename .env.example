# VibeGuard environment configuration
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control

# LLM Provider: 'openai' or 'anthropic'
VG_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Model selection
VG_OPENAI_MODEL=gpt-4o
VG_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Generation parameters
VG_TEMPERATURE=0.2
VG_MAX_TOKENS=4096

# Validation tools
VG_SEMGREP_ENABLED=true
VG_ESLINT_ENABLED=true
VG_SEMGREP_RULES=p/security-audit,p/javascript,p/owasp-top-ten

# Policy
VG_MAX_REGEN=3

# Logging
VG_LOG_DIR=./logs
VG_LOG_LEVEL=info
VG_PROVENANCE_FILE=./logs/provenance.jsonl
VG_METRICS_FILE=./logs/metrics.jsonl
